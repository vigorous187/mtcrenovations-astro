---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import portfolioData from '../data/portfolio.json';
import { findGalleryImage } from '../lib/gallery-images';
import 'photoswipe/style.css';

interface Props {
  service: string;
  serviceName: string;
}

const { service, serviceName } = Astro.props;

type PortfolioPhoto = {
  file: string;
  source_path: string;
  alt: string;
  score: number;
  project: string;
  room: string;
  type: string;
  explanation: string;
};

type ResolvedPhoto = PortfolioPhoto & { img: ImageMetadata };

// Get photos for this service from the data file
const servicePhotos: PortfolioPhoto[] = (portfolioData as Record<string, PortfolioPhoto[]>)[service] || [];

// Resolve each photo to its astro:assets import (S-06: responsive
// variants instead of the full-size originals).
async function resolve(photo: PortfolioPhoto): Promise<ResolvedPhoto | null> {
  const img = await findGalleryImage(service, photo.file);
  return img ? { ...photo, img } : null;
}

// Group photos by project
const projectGroups = new Map<string, PortfolioPhoto[]>();
for (const photo of servicePhotos) {
  const group = projectGroups.get(photo.project) || [];
  group.push(photo);
  projectGroups.set(photo.project, group);
}

// Sort projects by their best photo score (highest first), then by photo count
const sortedProjects = [...projectGroups.entries()].sort(
  (a, b) => {
    const scoreA = Math.max(...a[1].map(p => p.score));
    const scoreB = Math.max(...b[1].map(p => p.score));
    if (scoreB !== scoreA) return scoreB - scoreA;
    return b[1].length - a[1].length;
  }
);

// Hero photos: top 6 by score across all projects
const heroPhotos = (
  await Promise.all(servicePhotos.slice(0, 6).map(resolve))
).filter((p): p is ResolvedPhoto => p !== null);

const resolvedProjects = await Promise.all(
  sortedProjects.map(async ([projectName, photos]) => {
    const resolved = (await Promise.all(photos.map(resolve))).filter(
      (p): p is ResolvedPhoto => p !== null,
    );
    return { projectName, photos: resolved };
  }),
);

// Slug helper for data attributes
function slugify(name: string): string {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}

// Show up to 8 photos initially per project, rest behind "show more"
const INITIAL_GALLERY = 8;
---

<section class="py-5" style="background: var(--bg-base);">
  <div class="container">
    <div class="text-center mb-5">
      <p class="text-uppercase small fw-semibold mb-2" style="color: var(--mtc-red); letter-spacing: 0.08em;">Portfolio</p>
      <h2 class="font-display fw-bold" style="font-size: clamp(1.75rem, 3vw, 3rem);">Our {serviceName} Renovation Work</h2>
      <p style="color: var(--text-secondary);">Browse completed projects from Hamilton, Burlington and Halton</p>
    </div>

    {/* Hero Grid — top 6 highest-scored photos */}
    {heroPhotos.length > 0 && (
      <div class="row g-3 mb-5 reveal-stagger pswp-gallery">
        {heroPhotos.map((photo, i) => (
          <div class={`${i < 2 ? 'col-6 col-md-6' : 'col-6 col-md-4 col-lg-3'} reveal`}>
            <div class="portfolio-item" style={`height: ${i < 2 ? '320px' : '240px'};`}>
              <a href={photo.img.src} data-pswp-width={photo.img.width} data-pswp-height={photo.img.height}>
                <Picture
                  src={photo.img}
                  widths={[400, 800, 1200]}
                  sizes="(max-width: 767px) 50vw, 33vw"
                  formats={['avif', 'webp']}
                  alt={photo.alt}
                  class="w-100 h-100"
                  style="object-fit: cover;"
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
              </a>
            </div>
          </div>
        ))}
      </div>
    )}

    {/* Project Sections — grouped by street name */}
    {resolvedProjects.map(({ projectName, photos: projectPhotos }) => {
      if (projectPhotos.length === 0) return null;
      const projectSlug = slugify(projectName);
      const hasMore = projectPhotos.length > INITIAL_GALLERY;

      return (
        <div class="mb-5 project-section" data-project={projectSlug}>
          <h3 class="fw-bold mb-3" style="font-size: 1.25rem; color: var(--text-primary);">
            {projectName}
            <span class="text-muted fw-normal ms-2" style="font-size: 0.875rem;">
              {projectPhotos.length} photo{projectPhotos.length !== 1 ? 's' : ''}
            </span>
          </h3>
          <div class="row g-2 pswp-gallery">
            {projectPhotos.map((photo, idx) => (
              <div
                class="col-6 col-md-4 col-lg-3 portfolio-photo-col"
                data-project={projectSlug}
                data-index={idx}
                style={idx >= INITIAL_GALLERY ? 'display: none;' : undefined}
              >
                <div class="portfolio-item" style="height: 200px;">
                  <a href={photo.img.src} data-pswp-width={photo.img.width} data-pswp-height={photo.img.height}>
                    <Picture
                      src={photo.img}
                      widths={[400, 800, 1200]}
                      sizes="(max-width: 767px) 50vw, 33vw"
                      formats={['avif', 'webp']}
                      alt={photo.alt}
                      class="w-100 h-100"
                      style="object-fit: cover;"
                      loading="lazy"
                    />
                  </a>
                </div>
              </div>
            ))}
          </div>
          {hasMore && (
            <div class="text-center mt-3">
              <button
                class="btn btn-outline-secondary btn-sm show-more-btn"
                data-target={projectSlug}
                data-count={projectPhotos.length - INITIAL_GALLERY}
                type="button"
              >
                Show {projectPhotos.length - INITIAL_GALLERY} more photo{projectPhotos.length - INITIAL_GALLERY !== 1 ? 's' : ''}
              </button>
            </div>
          )}
        </div>
      );
    })}

    {servicePhotos.length === 0 && (
      <p class="text-center" style="color: var(--text-muted);">Portfolio photos coming soon.</p>
    )}
  </div>
</section>

<style>
  /* Picture/anchor wrappers must fill the fixed-height tile so the
     img's h-100 resolves (S-06). */
  .portfolio-item a,
  .portfolio-item picture {
    display: block;
    height: 100%;
  }
</style>

<script>
  function bindShowMore() {
    document.querySelectorAll('.show-more-btn:not([data-bound])').forEach(btn => {
      btn.setAttribute('data-bound', '1');
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-target');
        if (!target) return;
        document.querySelectorAll(`.portfolio-photo-col[data-project="${target}"]`).forEach(el => {
          (el as HTMLElement).style.display = '';
        });
        (btn as HTMLElement).style.display = 'none';
      });
    });
  }
  bindShowMore();
  document.addEventListener('astro:page-load', bindShowMore);
</script>

<script>
  // S-21: PhotoSwipe lightbox on the galleries; re-init after soft
  // navigation (fresh DOM nodes carry no data-pswp-init flag).
  import PhotoSwipeLightbox from 'photoswipe/lightbox';

  function initLightboxes() {
    document.querySelectorAll('.pswp-gallery:not([data-pswp-init])').forEach((el) => {
      el.setAttribute('data-pswp-init', '1');
      const lightbox = new PhotoSwipeLightbox({
        gallery: el as HTMLElement,
        children: 'a[data-pswp-width]',
        pswpModule: () => import('photoswipe'),
      });
      lightbox.init();
    });
  }
  initLightboxes();
  document.addEventListener('astro:page-load', initLightboxes);
</script>
