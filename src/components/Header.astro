---
import site from '../data/site.json';
import services from '../data/services.json';

const currentPath = Astro.url.pathname;
---

<header>
  <nav class="navbar navbar-expand-lg navbar-dark fixed-top glass-nav">
    <div class="container">
      <!-- Logo -->
      <a class="navbar-brand" href="/">
        <img src="/assets/img/logo/logo-white-100h.webp" width="106" height="100" alt={site.name} style="height: 50px; width: auto; max-height: 50px;" />
      </a>

      <!-- Mobile Toggle -->
      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#mainNav"
        aria-controls="mainNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <!-- Nav Links -->
      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav ms-auto align-items-center">
          <li class="nav-item">
            <a class:list={['nav-link', { active: currentPath === '/' }]} href="/">Home</a>
          </li>

          <!-- Services Dropdown -->
          <li class="nav-item dropdown">
            <a
              class="nav-link dropdown-toggle"
              href="#"
              role="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
            >
              Services
            </a>
            <ul class="dropdown-menu">
              {services.map(s => (
                <li>
                  <a class="dropdown-item" href={`/${s.slug}/`}>{s.name} Renovation</a>
                </li>
              ))}
              <li><hr class="dropdown-divider" /></li>
              <li>
                <a class:list={['dropdown-item', { active: currentPath === '/legal-basement-apartment-hamilton/' }]} href="/legal-basement-apartment-hamilton/">Legal basement apartment, Hamilton</a>
              </li>
              <li>
                <a class:list={['dropdown-item', { active: currentPath === '/fourplex-conversion-hamilton/' }]} href="/fourplex-conversion-hamilton/">Fourplex conversion, Hamilton</a>
              </li>
            </ul>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/locations/">Locations</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/blog/">Blog</a>
          </li>
          <li class="nav-item">
            <a class:list={['nav-link', { active: currentPath === '/faq/' }]} href="/faq/">FAQ</a>
          </li>
          <li class="nav-item">
            <a class:list={['nav-link', { active: currentPath === '/estimate/' }]} href="/estimate/">Price Guide</a>
          </li>

          <!-- Phone — always visible -->
          <li class="nav-item">
            <a class="nav-link" href="tel:+16475601095">
              <i class="fas fa-phone me-1"></i>{site.phone}
            </a>
          </li>

          <!-- Customer Login -->
          <li class="nav-item d-none d-lg-block">
            <a class="nav-link" href={site.jobtreadLogin} target="_blank" rel="noopener">
              <i class="fas fa-sign-in-alt me-1"></i>Login
            </a>
          </li>

          <!-- CTA -->
          <li class="nav-item ms-lg-2">
            <a class="btn btn-danger btn-sm px-3" href="/newleadintake/">
              Free Estimate
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>

<script>
  function initHeaderEscape() {
    if (document.documentElement.dataset.mtcHeaderEscapeInit) return;
    document.documentElement.dataset.mtcHeaderEscapeInit = 'true';
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const nav = document.getElementById('mainNav');
      const toggler = document.querySelector('.navbar-toggler');
      if (!nav || !(toggler instanceof HTMLElement)) return;
      // The menu counts as open while it carries 'show' AND while it is still
      // animating open ('collapsing' with aria-expanded="true"). Checking only
      // for 'show' missed Escape presses that landed during the opening
      // transition (e.g. focus still on the toggle right after Enter), and
      // Bootstrap's hide() is a no-op mid-transition — so defer the hide until
      // the open transition completes in that case.
      const isOpen = nav.classList.contains('show');
      const isOpening =
        nav.classList.contains('collapsing') &&
        toggler.getAttribute('aria-expanded') === 'true';
      if (!isOpen && !isOpening) return;
      const hideNav = () => {
        const bootstrapLib = (window as any).bootstrap;
        if (bootstrapLib?.Collapse) {
          bootstrapLib.Collapse.getOrCreateInstance(nav).hide();
        } else {
          toggler.click();
        }
      };
      if (isOpening) {
        nav.addEventListener(
          'shown.bs.collapse',
          function onShown() {
            nav.removeEventListener('shown.bs.collapse', onShown);
            hideNav();
          },
        );
      } else {
        hideNav();
      }
      toggler.focus();
    });
  }

  initHeaderEscape();
  document.addEventListener('astro:after-swap', initHeaderEscape);
</script>
