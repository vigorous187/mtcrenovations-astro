---
import type { ReviewItem, ReviewsBuildArtifact } from "../../lib/reviews-types";

interface Props {
  data: ReviewsBuildArtifact;
  title?: string;
  class?: string;
}

const { data, title = "What Our Clients Say", class: className = "" } = Astro.props;
const { aggregate, reviews } = data;
const showBlock = reviews.length > 0 && aggregate.count > 0;
const mapsUrl = data.googleReviewsUrl ?? "https://www.google.com/maps";
---

{showBlock && (
  <section class:list={["py-5", className]} style="background: var(--bg-surface-1, #f6f6f4);">
    <div class="container">
      <div class="text-center mb-5">
        <div class="d-inline-flex align-items-center gap-2 rounded-pill px-4 py-2 mb-3" style="background: #ffffff; border: 1px solid var(--border-default, rgba(20,20,20,0.1));">
          <span class="fw-semibold small" style="color: var(--text-muted, #5b5b57);">Google Reviews</span>
        </div>
        <h2 class="font-display fw-bold mb-2" style="color: var(--text-primary, #141414);">{title}</h2>
        <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">
          <span class="fs-3 fw-bold" style="color: var(--text-primary, #141414);">{aggregate.rating}</span>
          <span style="color: var(--text-muted, #5b5b57);">({aggregate.count} reviews)</span>
        </div>
      </div>

      <div id="reviewsCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="6000">
        <div class="carousel-inner">
          {reviews.map((review: ReviewItem, i: number) => (
            <div class:list={["carousel-item", { active: i === 0 }]}>
              <div class="row justify-content-center">
                <div class="col-12 col-md-8 col-lg-6">
                  <article class="review-card h-100 p-4 rounded-3 text-center" style="background: var(--bg-surface-2, #ffffff); border: 1px solid var(--border-default, rgba(20,20,20,0.1));">
                    <div class="mb-3" aria-label={`${review.rating} out of 5 stars`}>
                      {Array.from({ length: 5 }).map((_, si) => (
                        <span style={si < review.rating ? "color:#FBBC05" : "color:#d8d5cf"}>★</span>
                      ))}
                    </div>
                    {review.text && <p class="mb-3" style="color: var(--text-secondary, rgba(20,20,20,0.72));">{review.text}</p>}
                    <footer class="d-flex align-items-center justify-content-center gap-2 mt-auto">
                      {review.profilePhoto && (
                        <img src={review.profilePhoto} alt="" width="32" height="32" class="rounded-circle" loading="lazy" />
                      )}
                      <div class="text-start">
                        <strong class="d-block small" style="color: var(--text-primary, #141414);">{review.name}</strong>
                        {review.relativeTime && (
                          <span class="small" style="color: var(--text-muted, #5b5b57);">{review.relativeTime}</span>
                        )}
                      </div>
                    </footer>
                    {review.googleReviewUrl && (
                      <a
                        href={review.googleReviewUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="small d-block mt-2"
                        style="color: var(--mtc-red, #c8102e);"
                      >
                        View on Google
                      </a>
                    )}
                  </article>
                </div>
              </div>
            </div>
          ))}
        </div>

        {reviews.length > 1 && (
          <>
            <button class="carousel-control-prev" type="button" data-bs-target="#reviewsCarousel" data-bs-slide="prev">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#reviewsCarousel" data-bs-slide="next">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
              <span class="visually-hidden">Next</span>
            </button>
            <div class="carousel-indicators" style="position: static; margin-top: 1.5rem;">
              {reviews.map((_: ReviewItem, i: number) => (
                <button
                  type="button"
                  data-bs-target="#reviewsCarousel"
                  data-bs-slide-to={i}
                  class:list={{ active: i === 0 }}
                  aria-current={i === 0 ? "true" : undefined}
                  aria-label={`Review ${i + 1}`}
                ></button>
              ))}
            </div>
          </>
        )}
      </div>

      {aggregate.count > reviews.length && (
        <p class="text-center mt-4 mb-0">
          <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline-dark btn-sm">
            Read all {aggregate.count} reviews on Google
          </a>
        </p>
      )}

      <p class="text-center mt-4 mb-0 small" style="color: var(--text-muted, #5b5b57);">
        Reviews powered by Google
      </p>
    </div>
  </section>
)}
