---
interface Props {
  title: string;
  subtitle?: string;
  backgroundImage?: string;
  ctaText?: string;
  ctaLink?: string;
}

const {
  title,
  subtitle,
  backgroundImage = '/assets/img/kitchen/hero.jpg',
  ctaText = 'Get Free Estimate',
  ctaLink = '/estimate/',
} = Astro.props;

const heroSlug = backgroundImage.match(/\/img\/([^/]+)\/hero\.jpg$/)?.[1] ?? '';
---

<section
  class="position-relative d-flex align-items-center"
  style="min-height: 60vh;"
>
  <picture class="hero-media">
    <source
      type="image/webp"
      srcset={`/assets/img/${heroSlug}/hero-800.webp 800w, /assets/img/${heroSlug}/hero-1280.webp 1280w`}
      sizes="100vw"
    />
    <img
      src={`/assets/img/${heroSlug}/hero.jpg`}
      alt=""
      width="1200"
      height="800"
      fetchpriority="high"
      decoding="sync"
    />
  </picture>
  <div class="hero-overlay"></div>
  <div class="container position-relative text-center py-5" style="z-index: 2;">
    <h1 class="font-display fw-bold mb-3" style="font-size: clamp(2.5rem, 5vw, 4.5rem); color: var(--text-primary);">{title}</h1>
    {subtitle && <p class="h5 fw-normal mb-4" style="color: var(--text-secondary);">{subtitle}</p>}
    <a href={ctaLink} class="btn btn-danger btn-lg px-5 py-3">
      {ctaText}
    </a>
  </div>
</section>
