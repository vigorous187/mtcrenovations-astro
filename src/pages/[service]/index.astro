---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import CTABanner from '../../components/CTABanner.astro';
import EstimatorCTA from '../../components/estimator/EstimatorCTA.astro';
import { localBusiness, serviceSchema, breadcrumbList, faqPage } from '../../components/seo/schemas';
import site from '../../data/site.json';
import { reviewSummary } from '../../lib/googleReviews';
import services from '../../data/services.json';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const serviceEntries = await getCollection('services');
  return services.map(s => {
    const entry = serviceEntries.find(e => e.slug === s.slug);
    return {
      params: { service: s.slug },
      props: { service: s, entry },
    };
  });
}

const { service, entry } = Astro.props;
const { Content } = entry ? await entry.render() : { Content: null };

const serviceFaqs: Record<string, { question: string; answer: string }[]> = {
  kitchen: [
    {
      question: 'How much does a kitchen renovation cost?',
      answer:
        'Hamilton kitchen renovations typically range from $25,000 for a refreshed galley kitchen to $75,000+ for a full open-concept remodel with premium finishes. That is the range published on this page, not a quote. A fixed-price quote is prepared after an in-home consultation. The Burlington cost guide publishes its own tier table.',
    },
    {
      question: 'What does a kitchen renovation include?',
      answer:
        'Kitchen renovations include demolition, plumbing, electrical, framing, drywall, cabinetry, countertops, flooring, paint, and trim. Scope also covers custom cabinets, quartz or granite countertops, backsplash tile, islands, and lighting when those are part of the written scope.',
    },
    {
      question: 'Do you renovate kitchens in Hamilton, Burlington, and Oakville?',
      answer:
        'Yes. Hamilton, Burlington, and Oakville are in the MTC service area. Each city has its own location page, and the written quote is based on the kitchen we measure.',
    },
  ],
};

const pageFaqs = serviceFaqs[service.slug] ?? [];

const schemas = [
  localBusiness(),
  serviceSchema(service.name, service.slug, service.seo.description),
  breadcrumbList([
    { name: 'Home', url: site.url },
    { name: `${service.name} Renovation`, url: `${site.url}/${service.slug}` },
  ]),
  ...(pageFaqs.length ? [faqPage(pageFaqs)] : []),
];
---

<BaseLayout
  title={service.seo.title}
  description={service.seo.description}
  ogImage={`https://${site.domain}/assets/img/og/${service.slug}.png`}
  schema={schemas}
  heroPreload={{
    src: `/assets/img/${service.slug}/hero-800.webp`,
    srcset: `/assets/img/${service.slug}/hero-800.webp 800w, /assets/img/${service.slug}/hero-1280.webp 1280w`,
  }}
>
  <ServiceHero
    title={service.h1 || service.tagline}
    subtitle={`Professional ${service.name} Renovation in Hamilton, Burlington and Halton`}
    backgroundImage={service.heroImage}
    ctaText="Request a consultation"
    ctaLink={`/${service.slug}/get-free-quote/`}
  />

  <!-- Features -->
  {entry?.data.features && (
    <section class="py-5">
      <div class="container">
        <h2 class="text-center fw-bold mb-4">What We Do</h2>
        <div class="row g-3 justify-content-center">
          {entry.data.features.map((feature: string) => (
            <div class="col-md-6 col-lg-3">
              <div class="d-flex align-items-start gap-2 p-3">
                <i class="fas fa-check text-danger mt-1"></i>
                <span>{feature}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Content from markdown -->
  {Content && (
    <section class="py-5 bg-light">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-8 prose">
            <Content />
          </div>
        </div>
      </div>
    </section>
  )}

  {pageFaqs.length > 0 && (
    <section class="py-5">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-8">
            <h2 class="fw-bold mb-4">{service.name} renovation questions</h2>
            {pageFaqs.map((faq) => (
              <div class="mb-4">
                <h3 class="h5 fw-bold">{faq.question}</h3>
                <p class="mb-0">{faq.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  {['bathroom', 'kitchen'].includes(service.slug) && (
    <section class="py-5">
      <div class="container text-center">
        <h2 class="fw-bold mb-3">Explore our {service.name.toLowerCase()} renovation work</h2>
        <p>Browse <a class="text-decoration-underline" href={`/${service.slug}/our-work/`}>{service.name.toLowerCase()} project photos</a> for finishes and layout ideas.</p>
        <p>Planning several rooms? See our <a class="text-decoration-underline" href="/location/hamilton/">Hamilton renovation services</a> or <a class="text-decoration-underline" href="/location/burlington/">Burlington renovation services</a>, then tell us about your project.</p>
      </div>
    </section>
  )}

  <EstimatorCTA serviceSlug={service.slug} serviceName={service.name} />

  <!-- Why Choose Us -->
  {entry?.data.whyChooseUs && (
    <section class="py-5">
      <div class="container">
        <h2 class="text-center fw-bold mb-4">Why Choose MTC for {service.name} Renovation</h2>
        <div class="row g-4">
          {entry.data.whyChooseUs.map((item: { title: string; description: string }) => (
            <div class="col-md-6 col-lg-3">
              <div class="text-center p-3">
                <i class="fas fa-star text-danger mb-3" style="font-size: 2rem;"></i>
                <h3 class="h5 fw-bold">{item.title}</h3>
                <p class="text-secondary small">{item.description.replace('{{reviewSummary}}', reviewSummary)}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTABanner
    title={`Ready for Your ${service.name} Renovation?`}
    ctaText="Request a consultation"
    ctaLink={`/${service.slug}/get-free-quote/`}
  />
</BaseLayout>
