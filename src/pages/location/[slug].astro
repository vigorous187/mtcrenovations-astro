---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import { getCollection } from 'astro:content';
import { localBusiness, breadcrumbList } from '../../components/seo/schemas';
import site from '../../data/site.json';
import services from '../../data/services.json';

export async function getStaticPaths() {
  const cities = await getCollection('cities');
  return cities.map(city => ({
    params: { slug: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;
const citySlugs = new Set((await getCollection('cities')).map(entry => entry.slug));
const nearbyAreas = (city.data.nearbyAreas || [])
  .map((name: string) => ({ name, slug: name.toLowerCase().replace(/[\s.]+/g, '-') }))
  .filter(area => citySlugs.has(area.slug));
const isPriorityCity = ['hamilton', 'burlington'].includes(city.slug);
const { Content } = await city.render();

const schemas = [
  localBusiness(city.data.name),
  breadcrumbList([
    { name: 'Home', url: site.url },
    { name: 'Locations', url: `${site.url}/locations` },
    { name: city.data.name, url: `${site.url}/location/${city.slug}` },
  ]),
];
---

<BaseLayout
  title={city.data.metaTitle}
  description={city.data.metaDescription}
  schema={schemas}
>
  <!-- Hero -->
  <section class="bg-dark text-white py-5 text-center">
    <div class="container py-4">
      <span class="text-uppercase small text-danger fw-bold">Service Area</span>
      <h1 class="display-5 fw-bold mt-2 mb-3">{city.data.h1}</h1>
      <p class="lead text-white-50 mb-4">Licensed and insured renovation contractor serving {city.data.name} homeowners.</p>
      {isPriorityCity ? (
        <div class="d-flex flex-wrap gap-3 justify-content-center">
          <a href="/newleadintake/" class="btn btn-danger btn-lg px-5">Request a renovation consultation</a>
          <a href="/estimate/" class="btn btn-outline-light btn-lg px-5">Get a price range</a>
        </div>
      ) : <a href="/estimate/" class="btn btn-danger btn-lg px-5">Get a price range</a>}
    </div>
  </section>

  <!-- Content -->
  <section class="py-5">
    <div class="container">
      <div class="row justify-content-center">
        <div class:list={['col-lg-8 prose', { 'priority-city-copy': isPriorityCity }]}>
          <Content />
        </div>
      </div>
    </div>
  </section>

  <!-- Services in this city -->
  <section class="py-5 bg-light">
    <div class="container">
      <h2 class="text-center fw-bold mb-4">Our Services in {city.data.name}</h2>
      <div class="row g-4">
        {services.map(s => (
          <div class="col-md-6 col-lg-4">
            <a href={`/${s.slug}/`} class="text-decoration-none">
              <div class="card border-0 shadow-sm service-card h-100">
                <div class="card-body text-center p-4">
                  <img src={s.icon} alt={s.name} style="height: 40px;" class="mb-3" loading="lazy" />
                  <h3 class="h5 fw-bold text-dark">{s.name} Renovation</h3>
                  <p class="text-secondary small mb-0">{s.tagline}</p>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Nearby Areas -->
  {nearbyAreas.length > 0 && (
    <section class="py-5">
      <div class="container text-center">
        <h2 class="fw-bold mb-4">Nearby Areas We Serve</h2>
        <div class="d-flex flex-wrap justify-content-center gap-2">
          {nearbyAreas.map(area => (
            <a
              href={`/location/${area.slug}/`}
              class="btn btn-outline-dark btn-sm"
            >
              {area.name}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTABanner
    title={`Ready to Renovate in ${city.data.name}?`}
    subtitle="Tell us about the rooms, scope and timing you have in mind."
    ctaText="Request a renovation consultation"
    ctaLink="/newleadintake/"
  />
</BaseLayout>

<style>
  .priority-city-copy :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
